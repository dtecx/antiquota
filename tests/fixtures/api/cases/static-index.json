    "text": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<meta name=\"antiquota-token\" content=\"{{TOKEN}}\">\n<title>antiquota</title>\n<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n<link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n<link href=\"https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">\n<link rel=\"stylesheet\" href=\"/app.css\">\n</head>\n<body>\n<div class=\"app\" id=\"app\">\n  <aside class=\"side\" id=\"side\">\n    <div class=\"brand\">\n      <span class=\"mark\" aria-hidden=\"true\"><i></i><i></i></span>\n      <span class=\"word\">antiquota</span>\n      <button class=\"icon-btn side-close\" id=\"side-close\" title=\"Close sidebar\" aria-label=\"Close sidebar\">\u2715</button>\n    </div>\n    <button class=\"new-btn\" id=\"new-btn\" title=\"New session (\u2318N)\">\n      <span>New session</span><kbd>\u2318N</kbd>\n    </button>\n    <input class=\"search\" id=\"search\" type=\"search\" placeholder=\"Filter sessions\" aria-label=\"Filter sessions\">\n    <nav class=\"sessions\" id=\"sessions\" aria-label=\"Sessions\"></nav>\n    <div class=\"side-foot\">\n      <button class=\"acct-pill\" id=\"acct-pill\" title=\"Accounts and usage\">\n        <span class=\"strip\" id=\"ap-strip\" aria-hidden=\"true\"></span>\n        <span class=\"ap-text\"><b id=\"ap-main\">Accounts</b><span id=\"ap-sub\"></span></span>\n        <span class=\"ap-dot\" id=\"ap-dot\" hidden title=\"An account needs attention\"></span>\n      </button>\n      <button class=\"icon-btn set-gear\" id=\"set-open\" title=\"Settings (\u2318,)\" aria-label=\"Settings\">\n        <svg viewBox=\"0 0 16 16\" width=\"15\" height=\"15\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><circle cx=\"8\" cy=\"8\" r=\"2.2\"/><path d=\"M8 1.5v2M8 12.5v2M1.5 8h2M12.5 8h2M3.4 3.4l1.4 1.4M11.2 11.2l1.4 1.4M3.4 12.6l1.4-1.4M11.2 4.8l1.4-1.4\"/></svg>\n      </button>\n    </div>\n  </aside>\n\n  <main class=\"main\">\n    <header class=\"top\">\n      <button class=\"icon-btn side-open\" id=\"side-open\" title=\"Sessions\" aria-label=\"Open sessions\">\u2630</button>\n      <div class=\"top-title\">\n        <h1 id=\"title\" title=\"Click to rename\">antiquota</h1>\n        <span class=\"cwd\" id=\"cwd\"></span>\n      </div>\n      <div class=\"top-right\">\n        <span class=\"status\" id=\"status\" hidden></span>\n        <span class=\"tokens\" id=\"tokens\" title=\"Tokens used in this session\"></span>\n        <button class=\"icon-btn\" id=\"expand-btn\" title=\"Expand or collapse every step\" aria-label=\"Expand all steps\">\n          <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><path d=\"M4 6l4-3 4 3M4 10l4 3 4-3\"/></svg>\n        </button>\n        <button class=\"icon-btn\" id=\"detail-btn\" title=\"Previews and thinking\" aria-label=\"Toggle previews and thinking\">\n          <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><path d=\"M2 4h12M2 8h8M2 12h10\"/></svg>\n        </button>\n        <button class=\"icon-btn\" id=\"split-btn\" title=\"Side by side: a second session (\u2318\\\\)\" aria-label=\"Side by side\">\n          <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.3\"><rect x=\"1.5\" y=\"2.5\" width=\"5.5\" height=\"11\" rx=\"1.5\"/><rect x=\"9\" y=\"2.5\" width=\"5.5\" height=\"11\" rx=\"1.5\"/></svg>\n        </button>\n        <button class=\"icon-btn\" id=\"drawer-btn\" title=\"Changes, files, terminal (\u2318B)\" aria-label=\"Toggle side panel\">\n          <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\"><rect x=\"1.5\" y=\"2.5\" width=\"13\" height=\"11\" rx=\"2\" fill=\"none\" stroke=\"currentColor\"/><path d=\"M10 2.5v11\" stroke=\"currentColor\"/></svg>\n        </button>\n      </div>\n    </header>\n\n    <section class=\"scroll\" id=\"scroll\">\n      <div class=\"transcript\" id=\"transcript\"></div>\n    </section>\n\n    <footer class=\"dock\">\n      <div class=\"goalbar\" id=\"goalbar\" hidden></div>\n      <div class=\"jobbar\" id=\"jobbar\" hidden></div>\n      <div class=\"planbar\" id=\"planbar\" hidden></div>\n      <div class=\"slash\" id=\"slash\" hidden role=\"listbox\"></div>\n      <form class=\"composer\" id=\"composer\">\n        <div class=\"tray\" id=\"tray\" hidden></div>\n        <textarea id=\"input\" rows=\"1\" placeholder=\"Ask agy, @ to mention files, / for commands\" aria-label=\"Message\"></textarea>\n        <div class=\"tools\">\n          <button type=\"button\" class=\"attach-btn\" id=\"attach-btn\" title=\"Add images or files (or drop them, or paste a screenshot)\" aria-label=\"Add images or files\">+</button>\n          <input type=\"file\" id=\"attach-input\" multiple hidden>\n          <button type=\"button\" class=\"attach-btn mic-btn\" id=\"mic-btn\" title=\"Dictate a message\" aria-label=\"Dictate a message\">\n            <svg viewBox=\"0 0 16 16\" width=\"14\" height=\"14\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\"><rect x=\"5.5\" y=\"1.5\" width=\"5\" height=\"8.5\" rx=\"2.5\"/><path d=\"M3 7.5a5 5 0 0 0 10 0M8 12.5V15\"/></svg>\n          </button>\n          <span class=\"mic-state\" id=\"mic-state\" hidden></span>\n          <span class=\"mode-hint\" id=\"mode-hint\" hidden></span>\n          <label class=\"pick\"><span>model</span><select id=\"model\"></select></label>\n          <label class=\"pick\" title=\"Gemini models come in effort variants; Claude and GPT-OSS models have a fixed one\"><span>effort</span>\n            <select id=\"effort\"></select>\n          </label>\n          <label class=\"pick\" title=\"default: headless agy denies anything not in your allow rules \u00b7 accept edits: file edits allowed \u00b7 plan: read-only \u00b7 bypass: everything allowed\"><span>mode</span>\n            <select id=\"mode\">\n              <option value=\"default\">default</option>\n              <option value=\"accept-edits\">accept edits</option>\n              <option value=\"plan\">plan</option>\n              <option value=\"bypass\">bypass</option>\n            </select>\n          </label>\n          <button type=\"button\" class=\"goal-btn\" id=\"goal-btn\" title=\"Goal mode: keep going until verified\">\u25ce Goal</button>\n          <span class=\"grow\"></span>\n          <span class=\"queued\" id=\"queued\" hidden></span>\n          <button type=\"submit\" class=\"send\" id=\"send\" title=\"Send (Enter)\">Send</button>\n        </div>\n      </form>\n      <div class=\"meter\" id=\"meter\" aria-live=\"polite\"></div>\n    </footer>\n  </main>\n\n  <section class=\"split\" id=\"split\" hidden aria-label=\"Second session\"></section>\n\n  <aside class=\"drawer\" id=\"drawer\" hidden>\n    <div class=\"tabs\" role=\"tablist\">\n      <button role=\"tab\" data-tab=\"changes\" class=\"on\">Changes</button>\n      <button role=\"tab\" data-tab=\"files\">Files</button>\n      <button role=\"tab\" data-tab=\"terminal\">Terminal</button>\n    </div>\n    <div class=\"pane\" id=\"pane\"></div>\n  </aside>\n</div>\n\n<dialog id=\"new-dlg\" class=\"dlg\">\n  <form method=\"dialog\" id=\"new-form\">\n    <h2>New session</h2>\n    <label class=\"field\"><span>Working folder</span>\n      <input id=\"new-cwd\" required spellcheck=\"false\" autocomplete=\"off\">\n    </label>\n    <div class=\"browser\" id=\"browser\"></div>\n    <div class=\"row3\">\n      <label class=\"field\"><span>Model</span><select id=\"new-model\"></select></label>\n      <label class=\"field\"><span>Effort</span>\n        <select id=\"new-effort\"></select>\n      </label>\n      <label class=\"field\"><span>Mode</span>\n        <select id=\"new-mode\"><option value=\"default\">default</option><option value=\"accept-edits\">accept edits</option><option value=\"plan\">plan</option><option value=\"bypass\">bypass</option></select>\n      </label>\n    </div>\n    <label class=\"check\"><input type=\"checkbox\" id=\"new-worktree\">\n      <span><b>Separate git worktree</b> \u00b7 its own branch and folder, so parallel sessions never edit the same files; review and merge it back from Changes</span></label>\n    <div class=\"actions\">\n      <button value=\"cancel\" formnovalidate class=\"ghost\">Cancel</button>\n      <button value=\"ok\" class=\"primary\">Create</button>\n    </div>\n  </form>\n</dialog>\n\n<dialog id=\"goal-dlg\" class=\"dlg\">\n  <form method=\"dialog\" id=\"goal-form\">\n    <h2>Goal</h2>\n    <p class=\"lede\">The agent keeps working until it says the objective is done and your checks agree.\n      Quota walls pass the work to the next account; when every account is out, it sleeps until a reset.</p>\n    <label class=\"field\"><span>Objective</span>\n      <textarea id=\"goal-objective\" rows=\"4\" required placeholder=\"What must be true when this is done?\"></textarea>\n    </label>\n    <label class=\"field\"><span>Check command <em>optional, must exit 0</em></span>\n      <input id=\"goal-check\" spellcheck=\"false\" placeholder=\"python3 -m pytest -q\">\n    </label>\n    <div class=\"row3\">\n      <label class=\"field check\"><input type=\"checkbox\" id=\"goal-verifier\" checked><span>Independent verifier</span></label>\n      <label class=\"field\"><span>Verifier model</span><select id=\"goal-vmodel\"></select></label>\n      <label class=\"field\"><span>Max rounds</span><input id=\"goal-rounds\" type=\"number\" min=\"1\" max=\"500\" value=\"20\"></label>\n    </div>\n    <div class=\"actions\">\n      <button value=\"cancel\" formnovalidate class=\"ghost\">Cancel</button>\n      <button value=\"ok\" class=\"primary\">Start goal</button>\n    </div>\n  </form>\n</dialog>\n\n<dialog id=\"viewer\" class=\"dlg viewer\" aria-label=\"File\">\n  <header><code id=\"viewer-path\"></code><span class=\"fill\"></span>\n    <button type=\"button\" class=\"btn small\" id=\"viewer-copy\">Copy</button>\n    <button type=\"button\" class=\"btn small\" id=\"viewer-close\" aria-label=\"Close\">Close</button></header>\n  <div class=\"viewer-body\" id=\"viewer-body\"></div>\n</dialog>\n\n<dialog id=\"acct-dlg\" class=\"dlg\">\n  <form method=\"dialog\" id=\"acct-form\">\n    <h2>Add Google account</h2>\n    <p class=\"lede\">The account brings its own quota and uses antiquota's stack, separate from your agy CLI\n      and the IDE. agy allows 60 seconds from opening the sign-in page to the code arriving here.</p>\n    <ol class=\"steps\">\n      <li><button type=\"button\" class=\"primary\" id=\"acct-open\">Open Google sign-in</button>\n        <span class=\"timer\" id=\"acct-timer\"></span></li>\n      <li>Sign in with the account you want to add and allow access.</li>\n      <li><label class=\"field\"><span>Click \"Copy to Clipboard\" on Google's page and come back: the code goes in by itself</span>\n        <span class=\"code-row\"><input id=\"acct-code\" spellcheck=\"false\" autocomplete=\"off\" disabled placeholder=\"4/0A\u2026\">\n        <button type=\"button\" class=\"btn\" id=\"acct-clip\" title=\"Read the code from the clipboard\">Paste</button></span></label></li>\n    </ol>\n    <p class=\"acct-msg\" id=\"acct-msg\" role=\"status\"></p>\n    <div class=\"actions\">\n      <button value=\"cancel\" formnovalidate class=\"ghost\">Cancel</button>\n      <button type=\"button\" class=\"primary\" id=\"acct-finish\" disabled>Add account</button>\n    </div>\n  </form>\n</dialog>\n\n<div class=\"settings\" id=\"settings\" hidden role=\"dialog\" aria-label=\"Settings\">\n  <nav class=\"set-nav\">\n    <div class=\"set-head\"><b>Settings</b><button class=\"icon-btn\" id=\"set-close\" title=\"Close (Esc)\" aria-label=\"Close settings\">\u2715</button></div>\n    <div id=\"set-sections\"></div>\n    <p class=\"set-path\" id=\"set-path\"></p>\n  </nav>\n  <section class=\"set-body\" id=\"set-body\"></section>\n</div>\n\n<div class=\"dropzone\" id=\"dropzone\" hidden><div>Drop files to attach</div></div>\n<div class=\"toast\" id=\"toast\" role=\"status\" hidden></div>\n<script src=\"/app.js\"></script>\n</body>\n</html>\n"
  },
