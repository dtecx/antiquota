{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agy-loop",
  "version": "0.5.0",
  "identifier": "dev.dtecx.agyloop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Long agy runs across several Google accounts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
