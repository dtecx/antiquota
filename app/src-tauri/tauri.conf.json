{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Antiquota",
  "version": "0.5.0",
  "identifier": "dev.dtecx.antiquota",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": false
  },
  "plugins": {
    "opener": { "requireLiteralLeadingDot": false }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Long agy runs across several Google accounts",
    "longDescription": "A desktop workbench for Google's agy coding agent. It runs many agy sessions across several Google accounts and moves work to an account that still has quota.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {},
    "windows": {
      "wix": {
        "upgradeCode": "d3fb0228-8a26-5881-99f3-f8e438644727"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
